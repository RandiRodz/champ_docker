# Docker Compose Environment Configuration
# Uncomment and modify as needed

# ROS2 Distribution
# ROS_DISTRO=humble

# Workspace path inside container
# WORKSPACE=/ws

# Build type: Release or Debug
# BUILD_TYPE=Release

# Number of build jobs (increase for faster builds if you have more cores)
# BUILD_JOBS=4

# Enable GUI (for RViz/Gazebo)
# ENABLE_GUI=1

# Display variable (set automatically on Linux)
# DISPLAY=:0

# X11 Authority file
# XAUTHORITY=/root/.Xauthority
